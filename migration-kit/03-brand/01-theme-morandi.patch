diff --git a/frontend/src/style/theme.less b/frontend/src/style/theme.less
index 3c94da3..2a3e2e0 100644
--- a/frontend/src/style/theme.less
+++ b/frontend/src/style/theme.less
@@ -1,46 +1,48 @@
 /**
- * 全局主题：品牌色取自 logo 渐变区间
+ * 全局主题：莫兰迪色系（老大 2026-10-27 指定色板）
  *
- * 背景 —— `public/logo.png` 是「深蓝 → 青绿」的横向渐变，实测渐变曲线为：
- *   10% #033c85(深蓝, H=214) → 30% #055e95 → 50% #0c93ab → 70% #0db3b5 → 85% #0fbdba(青绿, H=179)
- * 色相沿渐变从 214° 过渡到 179°，明度从 27% 升到 40%。
+ * 四色板（不可改）：
+ *   深海蓝 Deep Sea Blue    #51697C  → 品牌主色（primary）
+ *   霜月白 Frost Moon White #F2F2EE  → 页面底色
+ *   雾蓝灰 Mist Blue Grey   #AAB7C2  → 次要文字 / 边框 / 占位
+ *   漂木棕 Driftwood Brown  #B79D88  → 强调 / 点缀 / 高亮标记（只做少量点缀，不大面积铺）
  *
- * 主色选取 —— 在渐变区间内逐点做「白字 WCAG 对比度 + 到渐变线距离 + 色相接近度」筛选，
- * 最终取 t≈42% 处的 `#0580a2`：
- *   - H=193 / S=94 / L=33，处在深蓝与青绿的交汇处，是渐变里最"干净"的经典青蓝色；
- *   - 白字对比度 4.55，达到 WCAG AA（按钮、选中态等白字场景可读）；
- *   - 与 logo 渐变线的最近距离 <1（RGB 空间），视觉上完全同源。
- * 渐变后半段（t>55%，如 #0db3b5）虽然更"青"，但白字对比度跌到 2.6~3.3，不适合作主色。
+ * 对比度实测（WCAG 相对亮度公式，脚本 `contrast.py`，2026-10-27 本地核算）：
+ *   白字 / #51697C 5.74（≥4.5 AA ✔，按钮、选中态白字可用）
+ *   #2A3843 正文 / #F2F2EE 10.72、/ #FFFFFF 12.03（主要文字）
+ *   #5F6E7A 次要文字 / #F2F2EE 4.68、/ #FFFFFF 5.25（AA ✔）
+ *   #7A8A98 占位 / #F2F2EE 3.16、/ #FFFFFF 3.55（占位按 3:1 放宽 ✔）
+ *   #B79D88 白字仅 2.56 → 漂木棕不做白字底；需白字的强调底用深一档 #8C7561（4.35）
+ *   深色模式 #5B7789 白字 4.72、对 #171B20 底色 3.66（品牌色在深底上仍可辨）
+ *
+ * 色阶规则 —— 沿用 TDesign 官方语义（brand-1 最浅 → brand-7 主色 → brand-10 最深）。
+ * 浅色阶锁定 H≈208（深海蓝色相），仅用明度/饱和度铺层次；深色阶整体上移明度（brand-7 由
+ * #51697C 提亮到 #5B7789），保证深底上品牌色不糊、白字按钮仍达 AA。
  *
  * ⚠ 选择器必须与 TDesign 同级（这是本文件最容易踩的坑）
  *   TDesign 把品牌色写在两个块里：
  *     `:root, :root[theme-mode='light'] { ... }`   → 特异性 (0,1,0) / (0,1,1)
- *     `:root.dark, :root[theme-mode='dark'] { ... }` → 特异性 (0,2,0) / (0,1,1)
+ *     `:root.dark, :root[theme-mode='dark'] { ... }` → (0,2,0) / (0,1,1)
  *   若这里只写 `:root`，一旦 `<html>` 上出现 `theme-mode` 属性（`stores/setting.ts` 切换主题时
  *   就会写），TDesign 的 `[theme-mode]` 块特异性更高，会把品牌色压回默认蓝；再切回浅色依旧如此。
  *   所以下面严格镜像 TDesign 的两套选择器：本文件在 `style/index.less` 引入、晚于 TDesign 基础样式
  *   加载，同特异性下靠「后加载」取胜，主题色才能在明暗切换中保持稳定。
- *
- * 色阶规则 —— 沿用 TDesign 官方色阶语义（brand-1 浅底 → brand-7 主色 → brand-10 最深），
- * 全部锁定 H=193（不漂移），仅通过明度/饱和度铺层次，保证 10 级色相一致、观感统一。
- * 暗色色阶同样锁 H=193，但整体上移明度（主色 `#0a7e9e`，白字对比度 4.68，保持 AA），
- * 使品牌色在深色背景上依然清晰可辨。
  */
 
 /* ========================= 亮色主题 ========================= */
 :root,
 :root[theme-mode='light'] {
-  // ---------- 品牌色 1~10 级色阶 ----------
-  --td-brand-color-1: #f6fafb; // 浅底 / 选中底
-  --td-brand-color-2: #ecf6f8; // light-hover
-  --td-brand-color-3: #ddf0f5; // disabled 底
-  --td-brand-color-4: #c6e7f1; // 浅边框
-  --td-brand-color-5: #90d6ea; // 深边框
-  --td-brand-color-6: #0398c1; // hover
-  --td-brand-color-7: #0580a2; // ★ 主色（logo 渐变中段）
-  --td-brand-color-8: #017190; // active
-  --td-brand-color-9: #035e77; // 深底强调
-  --td-brand-color-10: #054d61; // 最深强调
+  // ---------- 品牌色 1~10 级色阶（基于 #51697C）----------
+  --td-brand-color-1: #f5f7f8; // 浅底 / 选中底
+  --td-brand-color-2: #ebeff1; // light-hover
+  --td-brand-color-3: #dce2e6; // disabled 底
+  --td-brand-color-4: #c6d0d8; // 浅边框
+  --td-brand-color-5: #aab7c2; // 深边框（= 雾蓝灰）
+  --td-brand-color-6: #6b8296; // hover
+  --td-brand-color-7: #51697c; // ★ 主色（= 深海蓝）
+  --td-brand-color-8: #445a6b; // active
+  --td-brand-color-9: #374a58; // 深底强调
+  --td-brand-color-10: #2a3843; // 最深强调
 
   // ---------- 品牌色派生变量（覆盖 TDesign 默认映射）----------
   --td-brand-color: var(--td-brand-color-7);
@@ -53,22 +55,39 @@
   --td-brand-color-fade: var(--td-brand-color-1);
   --td-brand-color-focus-light: var(--td-brand-color-1);
 
+  // ---------- 中性色：底色 / 容器 / 边框 / 文字（莫兰迪中性）----------
+  --td-bg-color-page: #f2f2ee; // 霜月白：body 与布局内容区底色
+  --td-bg-color-container: #ffffff; // 卡片与容器：纯白，与霜月白拉开一档
+  --td-bg-color-container-hover: #f5f7f8;
+  --td-bg-color-secondarycontainer: #fafaf7; // 暖白：次级容器（表头、只读块）
+  --td-bg-color-secondarycontainer-hover: #f2f2ee;
+  --td-component-stroke: #dce2e6; // 分割线（雾蓝灰浅阶）
+  --td-component-border: #c6d0d8; // 描边（雾蓝灰深阶）
+  // TDesign 输入框 / 选择器 / 表格的边框走 border-level 系列，不跟 component-border，需单独接管
+  --td-border-level-1-color: #dce2e6;
+  --td-border-level-2-color: #c6d0d8;
+  --td-text-color-primary: #2a3843; // 主要文字：深海蓝最深阶，不用纯黑
+  --td-text-color-secondary: #5f6e7a; // 次要文字：对霜月白 4.68（AA）
+  --td-text-color-placeholder: #7a8a98; // 占位：对霜月白 3.16（占位按 3:1 放宽）
+  --td-text-color-disabled: #aab7c2;
+
   // ---------- 图表主色（跟随品牌色，保证 ECharts 与 UI 同源）----------
+  // 莫兰迪低饱和：同族内按明暗交替排列，相邻系列仍可区分
   --td-chart-color: var(--td-brand-color-7);
-  --td-chart-color-1: #0580a2;
-  --td-chart-color-2: #03a3cc;
-  --td-chart-color-3: #35c0d8;
-  --td-chart-color-4: #6fd5e8;
-  --td-chart-color-5: #a3e5f2;
-  --td-chart-color-6: #cdefa9;
-  --td-chart-color-7: #e8f5b8;
-  --td-chart-color-8: #f3e9a6;
-  --td-chart-color-9: #f7dfa0;
-  --td-chart-color-10: #f4d99c;
+  --td-chart-color-1: #51697c;
+  --td-chart-color-2: #b79d88;
+  --td-chart-color-3: #2a3843;
+  --td-chart-color-4: #aab7c2;
+  --td-chart-color-5: #6b8296;
+  --td-chart-color-6: #8c7561;
+  --td-chart-color-7: #374a58;
+  --td-chart-color-8: #c6d0d8;
+  --td-chart-color-9: #445a6b;
+  --td-chart-color-10: #7e96a9;
 
   // ---------- 投影：中性阴影里带一点品牌色，与整体色调呼应 ----------
-  --td-shadow-1: 0 1px 10px rgb(5 128 162 / 8%);
-  --td-shadow-2: 0 3px 6px -4px rgb(5 128 162 / 12%), 0 6px 16px rgb(5 128 162 / 8%);
+  --td-shadow-1: 0 1px 10px rgb(81 105 124 / 8%);
+  --td-shadow-2: 0 3px 6px -4px rgb(81 105 124 / 12%), 0 6px 16px rgb(81 105 124 / 8%);
 
   // ---------- 便捷别名：业务代码直接引用 ----------
   --app-brand: var(--td-brand-color-7); // 主色
@@ -76,29 +95,42 @@
   --app-brand-active: var(--td-brand-color-8); // active
   --app-brand-light: var(--td-brand-color-1); // 浅底
   --app-brand-border: var(--td-brand-color-4); // 浅边框
-  // 四色指标卡的第二档（青），与主色同族但更亮，保持卡片层次
-  --app-brand-accent: #03a3cc;
-  // logo 渐变（深蓝 → 青绿），用于横幅、欢迎条幅等装饰场景
-  --app-gradient-brand: linear-gradient(135deg, #033c85 0%, #0580a2 45%, #0db3b5 100%);
+  // 漂木棕：强调 / 点缀（标签、徽标、进度强调、hover 边框）——只做少量点缀
+  --app-brand-accent: #b79d88;
+  // 深一档漂木棕：需要白字的强调底（白字对比度 4.35）
+  --app-brand-accent-deep: #8c7561;
+  // 漂木棕半透明：分割线 / 光晕一类极轻的点缀
+  --app-accent-soft: rgb(183 157 136 / 45%);
+  // 页面 / 卡片 / 文字别名（业务组件带 fallback 的 var() 会优先取这里的值）
+  --app-page-bg: var(--td-bg-color-page);
+  --app-card-bg: var(--td-bg-color-container);
+  --app-text-primary: var(--td-text-color-primary);
+  --app-text-secondary: var(--td-text-color-secondary);
+  --app-table-head-bg: #fafaf7;
+  // 登录页渐变（浅色）：霜月白主底 + 雾蓝灰过渡 / 品牌区加一层漂木棕微暖
+  --app-login-bg: linear-gradient(135deg, #f2f2ee 0%, #eaeef0 52%, #f2f2ee 100%);
+  --app-login-brand: linear-gradient(155deg, #e8edf1 0%, #dce2e6 55%, #eae3db 100%);
+  // 品牌渐变（深海蓝深阶 → 主色 → hover 档），用于横幅、欢迎条幅等装饰场景
+  --app-gradient-brand: linear-gradient(135deg, #2a3843 0%, #51697c 55%, #6b8296 100%);
 }
 
 /* ========================= 暗色主题 =========================
- * 同一色相（H=193）整体提亮：1~6 级是深色背景上的浅色面（选中底/悬停底），
- * 7 级为主色（白字对比度 4.68，达 AA），8~10 级用于深底上的强调文字与边框。
+ * 同一色相（H≈208）整体提亮：1~6 级是深色背景上的浅色面（选中底/悬停底），
+ * 7 级为主色（白字对比度 4.72，达 AA），8~10 级用于深底上的强调文字与边框。
  * hover 取更亮的 8 级、active 取 6 级 —— 深色背景下「越交互越亮」才是正确方向。
  */
 :root.dark,
 :root[theme-mode='dark'] {
-  --td-brand-color-1: #10333c;
-  --td-brand-color-2: #134553;
-  --td-brand-color-3: #16586a;
-  --td-brand-color-4: #15687f;
-  --td-brand-color-5: #137996;
-  --td-brand-color-6: #0f8bae;
-  --td-brand-color-7: #0a7e9e; // ★ 暗色主色
-  --td-brand-color-8: #1491b3;
-  --td-brand-color-9: #35aed0;
-  --td-brand-color-10: #81c7da;
+  --td-brand-color-1: #1c262e;
+  --td-brand-color-2: #232e36;
+  --td-brand-color-3: #2a3740;
+  --td-brand-color-4: #33424e;
+  --td-brand-color-5: #45596a;
+  --td-brand-color-6: #4e6577;
+  --td-brand-color-7: #5b7789; // ★ 暗色主色（提亮以保持深底可辨，白字仍 AA）
+  --td-brand-color-8: #7591a5;
+  --td-brand-color-9: #93aabd;
