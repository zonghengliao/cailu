diff --git a/.githooks/pre-commit b/.githooks/pre-commit
new file mode 100755
index 0000000..51889ae
--- /dev/null
+++ b/.githooks/pre-commit
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# cailu pre-commit：阻止密钥/口令明文进入 git
+#
+# 安装（每个克隆执行一次）：
+#   git config core.hooksPath .githooks
+#
+# 设计：fail closed —— 扫描器不可用时拒绝提交，而不是静默放行。
+set -uo pipefail
+
+ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
+SCAN="$ROOT/scripts/secret-scan.sh"
+
+if [ ! -x "$SCAN" ]; then
+  chmod +x "$SCAN" 2>/dev/null || true
+fi
+if [ ! -f "$SCAN" ]; then
+  echo "✘ pre-commit: 找不到 $SCAN，拒绝提交。" >&2
+  echo "  如确需绕过（仅限紧急且已人工确认无密钥）：git commit --no-verify" >&2
+  exit 1
+fi
+
+# 允许跳过：仅在明确知道自己在做什么时使用
+if [ "${SKIP_SECRET_SCAN:-0}" = "1" ]; then
+  echo "! pre-commit: SKIP_SECRET_SCAN=1，跳过 secret 扫描（已记录到 stderr）" >&2
+  exit 0
+fi
+
+echo "▶ pre-commit secret 扫描（暂存区）"
+bash "$SCAN" --staged
+rc=$?
+[ "$rc" -eq 0 ] && exit 0
+
+echo "" >&2
+echo "✘ 提交被拒绝：疑似密钥/口令明文。" >&2
+echo "  处理方式：把密钥移出代码，改由环境变量注入（cailu 约定 ALUN_MIDDLEWARE_AUTH_JWT_SECRET 等），" >&2
+echo "  密钥文件放 /etc/cailu/<env>.env 并 chmod 600；详见 .gitleaks.toml 顶部说明。" >&2
+exit "$rc"
diff --git a/.github/workflows/secret-scan.yml b/.github/workflows/secret-scan.yml
new file mode 100644
index 0000000..1be0062
--- /dev/null
+++ b/.github/workflows/secret-scan.yml
@@ -0,0 +1,55 @@
+name: secret-scan
+
+# 目的：任何 PR / push 都不允许把 jwt_secret、password、*_secret 等明文带进仓库。
+# 规则见仓库根目录 .gitleaks.toml；扫描入口统一为 scripts/secret-scan.sh。
+#
+# 建议（上线前）：把 actions/checkout 固定到 commit SHA，避免 tag 被移动带来的供应链风险。
+
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: secret-scan-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  gitleaks:
+    name: gitleaks (tree + history)
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    env:
+      GITLEAKS_VERSION: 8.30.1
+    steps:
+      - name: Checkout (full history for history scan)
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Install gitleaks
+        run: |
+          set -euo pipefail
+          curl -sSL -o /tmp/gl.tar.gz \
+            "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
+          tar xzf /tmp/gl.tar.gz -C /tmp gitleaks
+          sudo install -m 0755 /tmp/gitleaks /usr/local/bin/gitleaks
+          gitleaks version
+
+      - name: Scan tracked files (HEAD tree)
+        run: bash scripts/secret-scan.sh --tree
+
+      - name: Scan full history
+        run: bash scripts/secret-scan.sh --history
+
+      - name: Upload report on failure
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: secret-scan-report
+          path: /tmp/cailu-secret-scan.json
+          if-no-files-found: ignore
+          retention-days: 7
diff --git a/.gitleaks.toml b/.gitleaks.toml
new file mode 100644
index 0000000..1b3e002
--- /dev/null
+++ b/.gitleaks.toml
@@ -0,0 +1,76 @@
+# cailu secret 扫描策略（gitleaks v8 配置）
+#
+# 目标：把「密钥明文进 git」这件事在提交阶段和 CI 阶段都拦住，
+# 至少覆盖 backend/config/*.toml 中的 jwt_secret / password / *_secret。
+#
+# 用法（本地/CI 统一走 scripts/secret-scan.sh，不要直接调 gitleaks）：
+#   bash scripts/secret-scan.sh --staged    # pre-commit：只扫暂存区
+#   bash scripts/secret-scan.sh --tree      # 只扫 HEAD 跟踪的文件
+#   bash scripts/secret-scan.sh --history   # 扫全部历史提交
+
+title = "cailu secrets policy"
+[extend]
+# 保留 gitleaks 内置规则（AWS/GitHub token/私钥/通用高熵串等）
+useDefault = true
+
+# ---------------------------------------------------------------- 规则 1
+# 本仓库最核心的一条：配置文件里的凭据赋值
+[[rules]]
+id = "cailu-config-toml-credential"
+description = "backend/config/*.toml 中出现 jwt_secret / password / *_secret 等明文赋值"
+regex = '''(?i)^\s*(jwt_secret|password|passwd|pwd|secret|secret_key|db_password|api_key|apikey|access_key|private_key|client_secret|[a-z0-9_]+_secret)\s*=\s*["']([^"']{2,})["']'''
+secretGroup = 2
+path = '''(^|/)backend/config/[^/]+\.toml$'''
+keywords = ["jwt_secret", "password", "_secret", "api_key", "secret"]
+
+  # 空值 / 明确的占位符不算泄露（例如 jwt_secret = ""、password = "${DB_PASSWORD}"）
+  [[rules.allowlists]]
+  description = "空值与占位符"
+  regexTarget = "secret"
+  regexes = [
+    '''^$''',
+    '''(?i)^(changeme|change_me|change-me|placeholder|dummy|todo|xxx+|your[_-]?[a-z]*|<[^>]+>|\$\{[^}]+\}|\$[A-Z_]+)$''',
+  ]
+
+  # config.toml 中的 `password = "alun"` 是 alun 框架 docker compose 的本地默认库口令，
+  # 生产/dev/test 三个真实环境都由 ALUN_DATABASE_PASSWORD 覆盖（见 /etc/cailu/*.env）。
+  # 已作为 P3 记入安全报告；在它被彻底去掉之前，这里先显式放行，避免 CI 永久红灯。
+  [[rules.allowlists]]
+  description = "config.toml 的 docker 本地默认库口令（P3，待改造）"
+  regexTarget = "match"
+  paths = ['''(^|/)backend/config/config\.toml$''']
+  regexes = ['''^\s*password\s*=\s*"alun"\s*$''']
+
+# ---------------------------------------------------------------- 规则 2
+# 兜底：任何文件里出现 jwt_secret 的字面赋值（防止有人换个扩展名 / 写进 .env.example）
+[[rules]]
+id = "cailu-jwt-secret-anywhere"
+description = "任何文件中出现 jwt_secret 字面赋值且值不像占位符"
+regex = '''(?i)jwt_secret["']?\s*[=:]\s*["']?([A-Za-z0-9_\-\.]{16,})["']?'''
+secretGroup = 1
+keywords = ["jwt_secret"]
+
+  [[rules.allowlists]]
+  description = "环境变量名/占位符/文档示例"
+  regexTarget = "secret"
+  regexes = [
+    '''(?i)^(please[_-]?change.*|change[_-]?me.*|your[_-].*|<.*>|\$\{.*\})$''',
+  ]
+
+# ---------------------------------------------------------------- 规则 3
+# 本仓库历史事故的直接防线：dev/test/prod 的 JWT 密钥前缀特征（cailu-<env>-jwt-secret-*）
+[[rules]]
+id = "cailu-jwt-secret-literal"
+description = "形如 cailu-{dev,test,prod}-jwt-secret-... 的历史密钥字面量"
+regex = '''cailu-(dev|test|prod)-jwt-secret-[A-Za-z0-9_\-]+'''
+keywords = ["jwt-secret-"]
+
+# ---------------------------------------------------------------- 全局排除
+[allowlist]
+description = "构建产物 / 依赖 / 版本库内部对象不参与扫描"
+paths = [
+  '''(^|/)backend/target/''',
+  '''(^|/)frontend/node_modules/''',
+  '''(^|/)frontend/dist/''',
+  '''(^|/)\.git/''',
+]
