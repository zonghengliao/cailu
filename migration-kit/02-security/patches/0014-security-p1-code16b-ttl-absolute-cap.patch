+async fn revoke_online_sessions(user_id: &uuid::Uuid, context: &'static str) {
+    if let Err(e) = crate::support::online::model::force_logout_user(&user_id.to_string()).await {
+        tracing::error!(
+            error = %e,
+            user_id = %user_id,
+            context,
+            "清理在线会话失败（令牌版本号 / 软删已在库侧生效）"
+        );
+    }
+}
