From 6d9310159421e9a803afbf584a66cb00df006776 Mon Sep 17 00:00:00 2001
From: manong <manong@local>
Date: Tue, 27 Oct 2026 18:23:39 +0800
Subject: [PATCH 08/15] =?UTF-8?q?security(P3):=20config.toml=20=E5=8E=BB?=
 =?UTF-8?q?=E6=8E=89=20docker=20=E9=BB=98=E8=AE=A4=E5=BA=93=E5=8F=A3?=
 =?UTF-8?q?=E4=BB=A4=20alun=EF=BC=8C=E6=92=A4=E9=94=80=E6=89=AB=E6=8F=8F?=
 =?UTF-8?q?=E5=99=A8=20allowlist?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

front matter: 承接 t_9b0f3578（安全复核）遗留的最后一条「配置文件里躺着口令」。

- backend/config/config.toml: password = "alun" -> ""，改为 ALUN_DATABASE_PASSWORD
  注入，写法与 jwt_secret = "" 一致；并写清「本地手工起服务前先 export」。
  依据：dev/test/prod 三套 /etc/cloudpivot/*.env 均已显式提供 ALUN_DATABASE_PASSWORD
  （实测都不是 alun，长度 32），prod 由 cloudpivot.service 的 EnvironmentFile 注入、
  dev 由 dev-up.sh `set -a; . /etc/cloudpivot/cloudpivot-dev.env` 注入，因此该 toml 默认值
  确实未被使用。
- docker/docker-compose.yml 不读该 toml：它用自己硬编码的 POSTGRES_PASSWORD: alun
  初始化本地开发库（/opt/cloudpivot 上跑的是系统 postgres，不是这套 compose），
  故无需改 compose，仅在 config.toml 注释里点明两者需保持一致。
- .gitleaks.toml: 删除 cloudpivot-config-toml-credential 下
  「config.toml 的 docker 本地默认库口令（P3，待改造）」这条 allowlist（含其上 3 行说明）。
- .gitleaks.toml: 规则 1 的 regex 补 (?m)。gitleaks 的多行匹配必须显式开启，
  否则 ^ 只锚定整段文本首行 —— 配置文件里第 2 行以后的赋值从未被该规则命中
  （实测：同一份含 password = "alun" 的文件，加 (?m) 前 dir 与 --staged 均 no leaks，
  加后立刻命中 1 处）。不修这条，删除 allowlist 只是纸面收口。
- scripts/secret-scan.sh: 删除内置降级规则里同一处 alun 例外（否则 gitleaks 缺失
  的机器上这条路径仍是盲区）。

验证：
- 负向：把 password = "alun" 写回 config.toml，gitleaks --staged 命中 1 处、
  降级规则命中 1 处，均 exit 1（提交前内部树扫描同样红 1 处）。
- 正向：bash scripts/secret-scan.sh --tree 绿；--history 仍红（历史提交里的旧密钥，
  待 t_b4501f87 的历史重写处理，本卡不处理）。
---
 .gitleaks.toml             | 13 +++----------
 backend/config/config.toml |  8 ++++++--
 scripts/secret-scan.sh     |  2 --
 3 files changed, 9 insertions(+), 14 deletions(-)

diff --git a/.gitleaks.toml b/.gitleaks.toml
index 1b3e002..4ee801a 100644
--- a/.gitleaks.toml
+++ b/.gitleaks.toml
@@ -17,8 +17,10 @@ useDefault = true
 # 本仓库最核心的一条：配置文件里的凭据赋值
 [[rules]]
 id = "cailu-config-toml-credential"
+# 必须带 (?m)：gitleaks 的多行匹配要显式开启，否则 `^` 只匹配整段文本首行，
+# 配置文件里第 2 行以后的赋值会漏检（2026-10-27 实测：加 (?m) 前 dir/--staged 均 no leaks）。
 description = "backend/config/*.toml 中出现 jwt_secret / password / *_secret 等明文赋值"
-regex = '''(?i)^\s*(jwt_secret|password|passwd|pwd|secret|secret_key|db_password|api_key|apikey|access_key|private_key|client_secret|[a-z0-9_]+_secret)\s*=\s*["']([^"']{2,})["']'''
+regex = '''(?im)^\s*(jwt_secret|password|passwd|pwd|secret|secret_key|db_password|api_key|apikey|access_key|private_key|client_secret|[a-z0-9_]+_secret)\s*=\s*["']([^"']{2,})["']'''
 secretGroup = 2
 path = '''(^|/)backend/config/[^/]+\.toml$'''
 keywords = ["jwt_secret", "password", "_secret", "api_key", "secret"]
@@ -32,15 +34,6 @@ keywords = ["jwt_secret", "password", "_secret", "api_key", "secret"]
     '''(?i)^(changeme|change_me|change-me|placeholder|dummy|todo|xxx+|your[_-]?[a-z]*|<[^>]+>|\$\{[^}]+\}|\$[A-Z_]+)$''',
   ]
 
-  # config.toml 中的 `password = "alun"` 是 alun 框架 docker compose 的本地默认库口令，
-  # 生产/dev/test 三个真实环境都由 ALUN_DATABASE_PASSWORD 覆盖（见 /etc/cailu/*.env）。
-  # 已作为 P3 记入安全报告；在它被彻底去掉之前，这里先显式放行，避免 CI 永久红灯。
-  [[rules.allowlists]]
-  description = "config.toml 的 docker 本地默认库口令（P3，待改造）"
-  regexTarget = "match"
-  paths = ['''(^|/)backend/config/config\.toml$''']
-  regexes = ['''^\s*password\s*=\s*"alun"\s*$''']
-
 # ---------------------------------------------------------------- 规则 2
 # 兜底：任何文件里出现 jwt_secret 的字面赋值（防止有人换个扩展名 / 写进 .env.example）
 [[rules]]
diff --git a/backend/config/config.toml b/backend/config/config.toml
index 766749b..0c6e6c7 100644
--- a/backend/config/config.toml
+++ b/backend/config/config.toml
@@ -28,9 +28,13 @@ type = "postgres"
 host = "127.0.0.1"
 port = 5432
 name = "cailu"
-# 本机（docker compose 的 alun-db-postgres-1）默认账号；生产环境用 ALUN_DATABASE_* 注入
+# 账号名（非凭据）：与 docker/docker-compose.yml 的本地开发库一致，可用 ALUN_DATABASE_USER 覆盖
 user = "alun"
-password = "alun"
+# 库口令一律由 ALUN_DATABASE_PASSWORD 注入，仓库内保持空值（本仓库为 public，禁止写入明文）：
+#   dev/test/prod 见 /etc/cailu/*.env（600）；本地手工起服务前先 export ALUN_DATABASE_PASSWORD=...
+#   （docker/docker-compose.yml 里的 POSTGRES_PASSWORD 是那套本地 compose 自己的库口令，
+#     两者需保持一致；后端启动不再依赖任何 toml 默认口令）
+password = ""
 password_encrypted = false
 max_connections = 10
 # 启动期 bootstrap 并发（种子/字典预热/参数快照等）会同时借出多条连接；
diff --git a/scripts/secret-scan.sh b/scripts/secret-scan.sh
index 972e484..a136f8d 100755
--- a/scripts/secret-scan.sh
+++ b/scripts/secret-scan.sh
@@ -64,8 +64,6 @@ for f in files():
         val = m.group(2)
         if ALLOW.match(val):
             continue
-        if re.search(r'(^|/)backend/config/config\.toml$', f) and re.fullmatch(r'\s*password\s*=\s*"alun"\s*', line):
-            continue
         hits += 1
         print(f"  ✘ {f}:{i}  {m.group(1)} = <REDACTED len={len(val)}>")
 print(f"内置规则命中 {hits} 处")
