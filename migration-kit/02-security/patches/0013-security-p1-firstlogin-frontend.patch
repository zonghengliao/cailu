+  padding: 24px;
+
+  &__panel {
+    width: 100%;
+    max-width: 460px;
+    padding: 32px;
+    background: var(--app-card-bg, #fff);
+    border-radius: 12px;
+    box-shadow: 0 8px 24px rgb(0 0 0 / 8%);
+  }
+
+  &__head {
+    margin-bottom: 20px;
+  }
+
+  &__title {
+    margin: 0 0 8px;
+    font-size: 20px;
+    font-weight: 600;
+    color: var(--app-text-primary, rgb(0 0 0 / 88%));
+  }
+
+  &__desc {
+    margin: 0;
+    font-size: 13px;
+    line-height: 20px;
+    color: var(--app-text-secondary, rgb(0 0 0 / 60%));
+  }
+
+  &__alert {
+    margin-bottom: 16px;
+  }
+}
+</style>
